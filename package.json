{
  "name": "kortex",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.kortex.launcher",
    "productName": "KortexLauncher",
    "publish": [
    {
      "provider": "github",
      "owner": "Dltrost",
      "repo": "krtxlnchr"
    }
  ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "./sources/kortexlogo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "**/*",
      "!games/**/*",
      "!play.js",
      "!test.js",
      "!getSrc.js",
      "!data.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/playwright-core/.local-browsers/",
        "to": "browsers",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "axios": "^1.17.0",
    "cheerio": "^1.2.0",
    "electron-updater": "^6.8.9",
    "got-scraping": "^4.2.1",
    "node-unrar-js": "^2.0.2",
    "playwright-core": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2"
  }
}
